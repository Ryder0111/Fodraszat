@{
    ViewData["Title"] = "Fodrász Vezérlőpult";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="m-0 text-dark">Fodrász Panel</h2>
            <p class="text-muted m-0 fs-5">Üdvözlünk, <span style="color: var(--accent-color); font-weight: bold;">@User.Identity.Name</span>!</p>
        </div>

    </div>

    <div class="bg-white p-4 rounded shadow-sm" style="min-height: 400px; border-top: 5px solid var(--primary-color);">
        <h4 style="color: var(--primary-color);">Napi Áttekintés</h4>
        <p class="text-muted mt-3">Válaszd ki a bal oldali menüből a naptáradat vagy a vendégeid listáját.</p>
    </div>
</div>