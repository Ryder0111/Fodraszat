@{
    ViewData["Title"] = "Fodrász Vezérlőpult";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="m-0 text-dark">Fodrász Panel</h2>
            <p class="text-muted m-0 fs-5">Üdvözlünk, <span style="color: var(--accent-color); font-weight: bold;">@User.Identity.Name</span>!</p>
        </div>

        <button class="btn-primary-custom border-0 shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasScrolling" aria-controls="offcanvasScrolling">
            <span class="fs-5">☰</span> Menü megnyitása
        </button>
    </div>

    <div class="bg-white p-4 rounded shadow-sm" style="min-height: 400px; border-top: 5px solid var(--primary-color);">
        <h4 style="color: var(--primary-color);">Napi Áttekintés</h4>
        <p class="text-muted mt-3">Válaszd ki a bal oldali menüből a naptáradat vagy a vendégeid listáját.</p>
    </div>
</div>

<div class="offcanvas offcanvas-start shadow" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="offcanvasScrolling" style="border-right: 1px solid #eee;">
    <div class="offcanvas-header" style="background-color: var(--primary-color); color: var(--bg-light);">
        <h5 class="offcanvas-title fw-bold">Kezelőpult</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body p-0" style="background-color: #fdfbf7;">
        <div class="list-group list-group-flush">
            <a href="#" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;">📅 Saját naptáram</a>
            <a href="#" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;">✂️ Napi foglalások</a>
            <a href="#" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;">⚙️ Profil beállítások</a>
            <a href="#" class="list-group-item list-group-item-action py-3 fw-bold text-danger" style="background-color: transparent;">🚪 Kijelentkezés</a>
        </div>
    </div>
</div>