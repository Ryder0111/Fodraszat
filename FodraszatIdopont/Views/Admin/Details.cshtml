@model FodraszatIdopont.Models.Entities.User

@{
    ViewData["Title"] = "Felhasználó Részletei";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="m-0 text-dark">Adatlap: <span style="color: var(--accent-color);">@Model.Name</span></h2>
            <p class="text-muted m-0 fs-5">Felhasználói profil és időpontok kezelése</p>
        </div>
        <a asp-action="Users" class="btn btn-outline-secondary shadow-sm px-4 py-2" style="border-radius: 5px;">
            <i class="fas fa-arrow-left me-2"></i> Vissza a listához
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="bg-white p-4 rounded shadow-sm mb-4" style="border-top: 5px solid var(--primary-color);">
                <div class="text-center mb-4">
                    <i class="fas fa-user-circle text-muted" style="font-size: 5rem; color: #eee !important;"></i>
                    <h4 class="mt-3 fw-bold" style="color: var(--primary-color);">@Model.Name</h4>

                    @if (Model.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Admin))
                    {
                        <span class="badge bg-danger px-3 py-2"><i class="fas fa-shield-alt me-1"></i> Adminisztrátor</span>
                    }
                    else if (Model.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Hairdresser))
                    {
                        <span class="badge px-3 py-2" style="background-color: var(--accent-color);"><i class="fas fa-cut me-1"></i> Fodrász</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2"><i class="fas fa-user me-1"></i> Vendég</span>
                    }
                </div>

                <hr style="border-color: #eee;" />

                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <strong style="color: var(--primary-color);"><i class="fas fa-envelope me-2"></i> Email:</strong><br />
                        <span class="text-muted ms-4">@Model.Email</span>
                    </li>
                    <li class="mb-3">
                        <strong style="color: var(--primary-color);"><i class="fas fa-venus-mars me-2"></i> Nem:</strong><br />
                        <span class="text-muted ms-4">@(Model.Sex.ToString() == "Male" ? "Férfi" : (Model.Sex.ToString() == "Female" || Model.Sex.ToString() == "Famale" ? "Nő" : "Egyéb"))</span>
                    </li>
                    <li>
                        <strong style="color: var(--primary-color);"><i class="fas fa-id-badge me-2"></i> Rendszer ID:</strong><br />
                        <span class="text-muted ms-4">#@Model.UserId</span>
                    </li>
                </ul>
            </div>

            @if (Model.Role != FodraszatIdopont.Models.Enums.UserRole.Admin)
            {
            <div class="bg-white p-4 rounded shadow-sm" style="border-top: 5px solid #dc3545;">
                <h5 class="text-danger fw-bold mb-3"><i class="fas fa-exclamation-triangle me-2"></i> Adminisztratív műveletek</h5>

                <form asp-action="ChangeRole" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userEmail" value="@Model.Email" />
                    <label class="form-label fw-bold text-muted small">Jogosultság módosítása</label>
                    <div class="input-group">
                        <select name="newRole" class="form-select" asp-for="Role">
                            @foreach (var role in Enum.GetValues(typeof(FodraszatIdopont.Models.Enums.UserRole)).Cast<FodraszatIdopont.Models.Enums.UserRole>().Where(r => r != FodraszatIdopont.Models.Enums.UserRole.Admin && r != FodraszatIdopont.Models.Enums.UserRole.None))
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary">Mentés</button>
                    </div>
                </form>
            </div>
            }
        </div>

        <div class="col-lg-8">

            <div class="bg-white p-4 rounded shadow-sm mb-4" style="border-top: 5px solid var(--accent-color);">
                <h4 class="fw-bold mb-4" style="color: var(--primary-color);">
                    <i class="far fa-calendar-check me-2"></i> Vendégként foglalt időpontjai
                </h4>

                @if (Model.Appointments != null && Model.Appointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-2">Dátum & Idő</th>
                                    <th class="py-2">Állapot</th>
                                    <th class="py-2 text-end">Művelet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.Appointments.OrderByDescending(a => a.StartTime))
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@app.StartTime.ToString("yyyy. MM. dd. HH:mm")</td>
                                        <td>
                                            <span class="badge bg-success">Foglalva</span>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="CancelAppointment" method="post" onsubmit="return confirm('Biztosan törlöd ezt az időpontot?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="appointmentId" value="@app.AppointmentId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Időpont törlése">
                                                    <i class="fas fa-times"></i> Törlés
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic m-0"><i class="fas fa-info-circle me-1"></i> Nincsenek vendégként foglalt időpontjai.</p>
                }
            </div>

            @if (Model.Role.ToString() == "Hairdresser" || (Model.HairdresserAppointments != null && Model.HairdresserAppointments.Any()))
            {
                <div class="bg-white p-4 rounded shadow-sm" style="border-top: 5px solid var(--primary-color);">
                    <h4 class="fw-bold mb-4" style="color: var(--primary-color);">
                        <i class="fas fa-cut me-2"></i> Fodrászként a beosztásában szereplő időpontok
                    </h4>

                    @if (Model.HairdresserAppointments != null && Model.HairdresserAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="py-2">Dátum & Idő</th>
                                        <th class="py-2">Állapot</th>
                                        <th class="py-2 text-end">Művelet</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.HairdresserAppointments.OrderByDescending(a => a.StartTime))
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@app.StartTime.ToString("yyyy. MM. dd. HH:mm")</td>
                                            <td>
                                                <span class="badge bg-primary">Beosztva</span>
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="CancelAppointment" method="post" onsubmit="return confirm('Biztosan törlöd ezt a fodrász beosztást/foglalást?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="appointmentId" value="@app.AppointmentId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-times"></i> Törlés
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic m-0"><i class="fas fa-info-circle me-1"></i> Jelenleg nincs egyetlen vendég sem beosztva hozzá.</p>
                    }
                </div>
            }

        </div>
    </div>
</div>
