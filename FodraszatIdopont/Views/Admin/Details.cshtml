@model FodraszatIdopont.Models.Entities.User

@{
    ViewData["Title"] = "Felhasználó Részletei";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="m-0 text-dark">Adatlap: <span style="color: var(--accent-color);">@Model.Name</span></h2>
            <p class="text-muted m-0 fs-5">Felhasználói profil és időpontok kezelése</p>
        </div>
        <a asp-action="Users" class="btn btn-outline-secondary shadow-sm px-4 py-2" style="border-radius: 5px;">
            <i class="fas fa-arrow-left me-2"></i> Vissza a listához
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="bg-white p-4 rounded shadow-sm mb-4" style="border-top: 5px solid var(--primary-color);">
                <div class="text-center mb-4">

                    @{
                        // Kiszámoljuk a kezdőbetűt a fallback (helyettesítő) képhez
                        var firstLetter = !string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "?";
                    }

                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        // Ha van feltöltött képe, azt mutatjuk meg
                        <img src="@Model.ProfileImageUrl" alt="Profilkép" class="rounded-circle shadow-sm mb-2" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;" />
                    }
                    else
                    {
                        // Ha nincs képe, a szép színes kezdőbetűs kört mutatjuk (mx-auto középre igazítja)
                        <div class="rounded-circle shadow-sm d-flex justify-content-center align-items-center mx-auto mb-2" style="width: 120px; height: 120px; background-color: var(--primary-color); color: white; font-size: 3rem; font-weight: bold; border: 4px solid #fff;">
                            @firstLetter
                        </div>
                    }

                    <h4 class="mt-3 fw-bold" style="color: var(--primary-color);">@Model.Name</h4>

                    @if (Model.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Admin))
                    {
                        <span class="badge bg-danger px-3 py-2"><i class="fas fa-shield-alt me-1"></i> Adminisztrátor</span>
                    }
                    else if (Model.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Hairdresser))
                    {
                        <span class="badge px-3 py-2" style="background-color: var(--accent-color);"><i class="fas fa-cut me-1"></i> Fodrász</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2"><i class="fas fa-user me-1"></i> Vendég</span>
                    }
                </div>

                <hr style="border-color: #eee;" />

                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <strong style="color: var(--primary-color);"><i class="fas fa-envelope me-2"></i> Email:</strong><br />
                        <span class="text-muted ms-4">@Model.Email</span>
                    </li>
                    <li class="mb-3">
                        <strong style="color: var(--primary-color);"><i class="fas fa-venus-mars me-2"></i> Nem:</strong><br />
                        <span class="text-muted ms-4">@(Model.Sex.ToString() == "Male" ? "Férfi" : (Model.Sex.ToString() == "Female" || Model.Sex.ToString() == "Famale" ? "Nő" : "Egyéb"))</span>
                    </li>
                    <li>
                        <strong style="color: var(--primary-color);"><i class="fas fa-id-badge me-2"></i> Rendszer ID:</strong><br />
                        <span class="text-muted ms-4">#@Model.UserId</span>
                    </li>
                </ul>
            </div>

            @if (Model.Role != FodraszatIdopont.Models.Enums.UserRole.Admin)
            {
            <div class="bg-white p-4 rounded shadow-sm" style="border-top: 5px solid #dc3545;">
                <h5 class="text-danger fw-bold mb-3"><i class="fas fa-exclamation-triangle me-2"></i> Adminisztratív műveletek</h5>

                <form id="ChageRoleForm" asp-action="ChangeRole" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userEmail" value="@Model.Email" />
                    <label class="form-label fw-bold text-muted small">Jogosultság módosítása</label>
                    <div class="input-group">
                        <select name="newRole" class="form-select" asp-for="Role">
                            @foreach (var role in Enum.GetValues(typeof(FodraszatIdopont.Models.Enums.UserRole)).Cast<FodraszatIdopont.Models.Enums.UserRole>().Where(r => r != FodraszatIdopont.Models.Enums.UserRole.Admin && r != FodraszatIdopont.Models.Enums.UserRole.None))
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary">Mentés</button>
                    </div>
                </form>
            </div>
            }
        </div>

        <div class="col-lg-8">

            <div class="bg-white p-4 rounded shadow-sm mb-4" style="border-top: 5px solid var(--accent-color);">
                <h4 class="fw-bold mb-4" style="color: var(--primary-color);">
                    <i class="far fa-calendar-check me-2"></i> Vendégként foglalt időpontjai
                </h4>

                @if (Model.Appointments != null && Model.Appointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-2">Dátum & Idő</th>
                                    <th class="py-2">Állapot</th>
                                    <th class="py-2 text-end">Művelet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.Appointments.OrderByDescending(a => a.StartTime))
                                {
                                    // Megnézzük, hogy törölve van-e, és ha igen, egy kis szürkeséget adunk a sornak
                                    var isCancelled = app.AppointmentStatus.HasFlag(FodraszatIdopont.Models.Enums.AppointmentStatus.Cancelled);
                                    var rowClass = isCancelled ? "table-light text-muted opacity-75" : "align-middle";

                                    <tr class="@rowClass" style="transition: all 0.3s ease;">

                                        <td class="@(isCancelled ? "" : "text-theme-primary") fw-bold py-3">
                                            <i class="far fa-calendar-alt me-2 @(isCancelled ? "" : "text-theme-accent")"></i>
                                            @app.StartTime.ToString("yyyy. MM. dd. HH:mm")
                                        </td>

                                        <td>
                                            @if (isCancelled)
                                            {
                                                <span class="badge bg-danger shadow-sm"><i class="fas fa-ban me-1"></i> Lemondva</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success shadow-sm"><i class="fas fa-check-circle me-1"></i> Aktív</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            @if (!isCancelled)
                                            {
                                                <form id="cancelForm_@app.AppointmentId" asp-action="CancelAppointment" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@Model.UserId" />
                                                    <input type="hidden" name="appointmentId" value="@app.AppointmentId" />

                                                    <button type="button" class="btn btn-sm btn-outline-danger shadow-sm" onclick="confirmCancel('cancelForm_@app.AppointmentId')">
                                                        <i class="fas fa-times me-1"></i> Lemondás
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="small fst-italic" style="color: var(--text-muted);">
                                                    <i class="fas fa-info-circle me-1"></i> Az időpont törölve lett.
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic m-0"><i class="fas fa-info-circle me-1"></i> Nincsenek vendégként foglalt időpontjai.</p>
                }
            </div>

            @if (Model.Role.ToString() == "Hairdresser" || (Model.HairdresserAppointments != null && Model.HairdresserAppointments.Any()))
            {
                <div class="bg-white p-4 rounded shadow-sm" style="border-top: 5px solid var(--primary-color);">
                    <h4 class="fw-bold mb-4" style="color: var(--primary-color);">
                        <i class="fas fa-cut me-2"></i> Fodrászként a beosztásában szereplő időpontok
                    </h4>

                    @if (Model.HairdresserAppointments != null && Model.HairdresserAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="py-2">Dátum & Idő</th>
                                        <th class="py-2">Állapot</th>
                                        <th class="py-2 text-end">Művelet</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.HairdresserAppointments.OrderByDescending(a => a.StartTime))
                                    {
                                        // Megnézzük a státuszokat
                                        var isCancelled = app.AppointmentStatus.HasFlag(FodraszatIdopont.Models.Enums.AppointmentStatus.Cancelled);
                                        var isCompleted = app.AppointmentStatus.HasFlag(FodraszatIdopont.Models.Enums.AppointmentStatus.Completed);

                                        // Ha le van mondva, szürkébb lesz. (Az elvégzettet hagyhatjuk normál színnel, hogy jól olvasható maradjon)
                                        var rowClass = isCancelled ? "table-light text-muted opacity-75 align-middle" : "align-middle";

                                        <tr class="@rowClass" style="transition: all 0.3s ease;">

                                            <td class="@(isCancelled ? "" : "text-theme-primary") fw-bold py-3">
                                                <i class="far fa-calendar-alt me-2 @(isCancelled ? "" : "text-theme-accent")"></i>
                                                @app.StartTime.ToString("yyyy. MM. dd. HH:mm")
                                            </td>

                                            <td>
                                                @if (isCancelled)
                                                {
                                                    <span class="badge bg-danger shadow-sm"><i class="fas fa-ban me-1"></i> Lemondva</span>
                                                }
                                                else if (isCompleted)
                                                {
                                                    <span class="badge bg-info shadow-sm"><i class="fas fa-check-double me-1"></i> Elvégezve</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success shadow-sm"><i class="fas fa-clock me-1"></i> Aktív</span>
                                                }
                                            </td>

                                            <td class="text-end">
                                                @if (isCancelled)
                                                {
                                                    <span class="small fst-italic" style="color: var(--text-muted);">
                                                        <i class="fas fa-info-circle me-1"></i> Az időpont törölve lett.
                                                    </span>
                                                }
                                                else if (isCompleted)
                                                {
                                                    <span class="small fst-italic text-success fw-bold">
                                                        <i class="fas fa-check me-1"></i> Szolgáltatás teljesítve
                                                    </span>
                                                }
                                                else
                                                {
                                                    // Ha sem nem törölt, sem nem elvégzett, akkor még aktív -> jöhet a lemondás gomb
                                                    <form id="cancelForm_@app.AppointmentId" asp-action="CancelAppointment" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@Model.UserId" />
                                                        <input type="hidden" name="appointmentId" value="@app.AppointmentId" />

                                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm" onclick="confirmCancel('cancelForm_@app.AppointmentId')">
                                                            <i class="fas fa-times me-1"></i> Lemondás
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic m-0"><i class="fas fa-info-circle me-1"></i> Jelenleg nincs egyetlen vendég sem beosztva hozzá.</p>
                    }
                </div>
            }

        </div>
    </div>
</div>

<script>
    
    function confirmCancel(formId) {
        Swal.fire({
            title: 'Biztosan lemondod?',
            text: "Ezt a műveletet később nem vonhatod vissza!",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#dc3545', // Danger piros a lemondáshoz
            cancelButtonColor: '#6c757d',  // Szürke a mégsem gombhoz
            confirmButtonText: 'Igen, lemondom!',
            cancelButtonText: 'Mégsem'
        }).then((result) => {
            if (result.isConfirmed) {
                // Megkeresi a formot az egyedi ID alapján, és beküldi a szerverre
                document.getElementById(formId).submit();
            }
        });
    }

    // Megfogjuk a formot az ID-ja alapján
    document.getElementById('ChageRoleForm').addEventListener('submit', function(e) {
        // Megállítjuk az azonnali elküldést
        e.preventDefault();

        // Elindítjuk a gyönyörű felugró ablakot
        Swal.fire({
            title: 'Biztosan módosítod?',
            text: "A felhasználó jogosultsága meg fog változni!",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd', // Bootstrap primary kék szín
            cancelButtonColor: '#dc3545',  // Bootstrap danger piros szín
            confirmButtonText: 'Igen, módosítom!',
            cancelButtonText: 'Mégsem'
        }).then((result) => {
            // Ha a felhasználó az 'Igen'-re kattintott
            if (result.isConfirmed) {
                // Most már ténylegesen beküldjük a formot
                this.submit();
            }
        })
    });

</script>
