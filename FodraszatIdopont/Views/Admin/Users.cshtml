@model List<FodraszatIdopont.Models.Entities.User>

@{
    ViewData["Title"] = "Felhasználók Kezelése";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="m-0 text-dark">Felhasználók</h2>
            <p class="text-muted m-0 fs-5">A rendszerben regisztrált vendégek és munkatársak listája.</p>
        </div>
    </div>

    <div class="bg-white p-4 rounded shadow-sm" style="border-top: 5px solid var(--primary-color);">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--primary-color); color: var(--bg-light);">
                    <tr>
                        <th class="py-3 px-4 rounded-start" style="width: 80px;">ID</th>
                        <th class="py-3 px-4">Név</th>
                        <th class="py-3 px-4">Email cím</th>
                        <th class="py-3 px-4">Nem</th>
                        <th class="py-3 px-4 text-end rounded-end">Műveletek</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr style="border-bottom: 1px solid #eee;">
                                <td class="px-4 fw-bold text-muted">#@user.UserId</td>

                                <td class="px-4 fw-bold" style="color: var(--primary-color);">
                                    @if (user.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Admin))
                                    {
                                        <i class="fas fa-shield-alt me-1"></i>
                                    }
                                    else if (user.Role.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Hairdresser))
                                    {
                                        <i class="fas fa-cut me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-user me-1"></i>
                                    }
                                    @user.Name
                                </td>

                                <td class="px-4 text-muted">@user.Email</td>

                                <td class="px-4">
                                    @if (user.Sex.ToString() == "Male")
                                    {
                                        <span class="badge" style="background-color: #e9ecef; color: #495057; padding: 8px 12px;">
                                            <i class="fas fa-mars me-1"></i> Férfi
                                        </span>
                                    }
                                    else if (user.Sex.ToString() == "Female" || user.Sex.ToString() == "Famale")
                                    {
                                        <span class="badge" style="background-color: #fdf2f2; color: #d9534f; padding: 8px 12px; border: 1px solid #fadcdc;">
                                            <i class="fas fa-venus me-1"></i> Nő
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="padding: 8px 12px;">Egyéb</span>
                                    }
                                </td>

                                <td class="px-4 text-end">
                                    <a class="btn btn-sm text-white px-3 py-2 shadow-sm"
                                       style="background-color: var(--accent-color); border-radius: 5px; transition: 0.3s;"
                                       asp-action="Details"
                                       asp-route-id="@user.UserId"
                                       onmouseover="this.style.backgroundColor='var(--primary-color)'"
                                       onmouseout="this.style.backgroundColor='var(--accent-color)'">
                                        <i class="fas fa-user-edit me-1"></i> Bővebben
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-users-slash fs-1 mb-3" style="color: #eee;"></i><br />
                                <span class="fs-5">Még nincsenek felhasználók a rendszerben.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>