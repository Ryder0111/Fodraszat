@model FodraszatIdopont.Models.AppointmentDTO

@{
    ViewData["Title"] = "Időpontfoglalás";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h2>Foglalj időpontot</h2>
        <p style="color: var(--text-muted); font-size: 1.2rem;">Válaszd ki a fodrászt, a szolgáltatást, majd egy szabad időpontot.</p>
    </div>

    <form asp-action="CreateAppointment" method="post" class="mx-auto bg-white p-4 p-md-5 rounded shadow-sm" style="max-width: 800px; border-top: 5px solid var(--primary-color);">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Appointment.UserId" />
        <input type="hidden" id="startTimeInput" asp-for="Appointment.StartTime" />

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label fw-bold" style="color: var(--primary-color);">Válassz fodrászt</label>
                <select id="hairdresserSelect" class="form-select form-select-lg shadow-sm" asp-for="Appointment.HairdresserId" style="border-color: #eee;">
                    <option value="">-- Kérlek válassz --</option>
                    @foreach (var item in Model.Hairdressers)
                    {
                        <option value="@item.UserId">@item.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold" style="color: var(--primary-color);">Válassz szolgáltatást</label>
                <select id="serviceSelect" class="form-select form-select-lg shadow-sm" asp-for="Appointment.ServiceId" style="border-color: #eee;">
                    <option value="">-- Kérlek válassz --</option>
                    @foreach (var item in Model.Services)
                    {
                        <option data-duration="@item.DurationInMinute" value="@item.ServiceId">@item.Name</option>
                    }
                </select>
            </div>
        </div>

        <div id="calendarSection" style="display: none;" class="mt-5 pt-3 border-top">
            <div class="calendar-wrapper">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <button type="button" class="btn btn-outline-dark" id="btnPrevMonth">&lt; Előző</button>
                    <h3 id="currentMonthYear" class="m-0 fw-bold" style="color: var(--primary-color);"></h3>
                    <button type="button" class="btn btn-outline-dark" id="btnNextMonth">Következő &gt;</button>
                </div>

                <div class="table-responsive">
                    <table class="custom-calendar w-100" id="appointmentCalendar">
                        <thead>
                            <tr>
                                <th>H</th>
                                <th>K</th>
                                <th>Sze</th>
                                <th>Cs</th>
                                <th>P</th>
                                <th>Szo</th>
                                <th>V</th>
                            </tr>
                        </thead>
                        <tbody id="calendarBody"></tbody>
                    </table>
                </div>

                <div id="calendarMessage" class="text-center mt-3 text-danger fw-bold fs-5"></div>
            </div>
        </div>

        <div class="text-center mt-5">
            <button id="submitBtn" type="submit" class="btn-primary-custom w-100 border-0" disabled style="opacity: 0.5; cursor: not-allowed;">
                Időpont lefoglalása
            </button>
            <p id="submitHelperText" class="text-muted mt-2 small">Kérlek válassz egy pontos időpontot a naptárból a foglaláshoz.</p>
        </div>
    </form>
</div>

<script src="~/js/MAAppointment_Calendar.js" asp-append-version="true"></script>