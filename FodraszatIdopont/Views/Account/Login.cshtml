@model FodraszatIdopont.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Bejelentkezés";
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h2>Bejelentkezés</h2>
        <p style="color: var(--text-muted); font-size: 1.2rem;">Időpontfoglalás előtt jelentkezz be!</p>
        <p style="color: var(--text-muted); font-size: 1.2rem;">Lépj be a fiókodba a foglalásaid kezeléséhez.</p>
    </div>

    <form id="loginForm" asp-action="Login" method="post" class="mx-auto bg-white p-4 p-md-5 rounded shadow-sm" style="max-width: 500px; border-top: 5px solid var(--primary-color);">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="form-label fw-bold" style="color: var(--primary-color);">Email cím</label>
            <input type="text" asp-for="Email" class="form-control form-control-lg @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="email@pelda.com" style="border-color: #eee;">
            <span asp-validation-for="Email" class="invalid-feedback"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold" style="color: var(--primary-color);">Jelszó</label>

            <div class="input-group">
                <input type="password" asp-for="Password"
                       class="form-control form-control-lg password @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                       placeholder="••••••••"
                       style="border-color: #eee; border-right: 0;"> <span class="input-group-text bg-white" style="border-color: #eee; border-left: 0;">
                    <i class="fa fa-eye text-muted" style="cursor: pointer;"></i>
                </span>

                <span asp-validation-for="Password" class="invalid-feedback"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input class="form-check-input" asp-for="RememberMe" type="checkbox" id="rememberMe">
                <label class="form-check-label text-muted" for="rememberMe">Emlékezz rám</label>
            </div>
        </div>

        <input type="hidden" id="recaptchaToken" name="recaptchaToken" />

        <button type="submit" class="btn-primary-custom w-100 border-0 mb-3">Bejelentkezés</button>
        <div class="text-center mt-3">
            <span class="text-muted">Még nincs fiókod?</span>
            <a asp-action="Registration" class="text-decoration-none fw-bold" style="color: var(--primary-color);">Regisztrálj itt!</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#loginForm').on('submit', function (e) {
                e.preventDefault(); 
                var form = $(this);

                if (!form.valid()) {
                    return; 
                }

                grecaptcha.ready(function () {
                    grecaptcha.execute('6LcZrYUsAAAAAACP_E34b7Jk6tQ998dO0969edqR', { action: 'login' }).then(function (token) {
                        var recaptchaInput = document.getElementById("recaptchaToken");
                        if (recaptchaInput) {
                            recaptchaInput.value = token;
                        }
                        form[0].submit();
                    });
                });
            });
        });
    </script>
}