@using FodraszatIdopont.Services.Interface
@inject ICurrentUserService _CurrentUserService

@* Egy fő C# blokkban előkészítjük az adatokat *@
@{
    string userName = "Vendég";
    string initial = "?";
    string? profilePicUrl = null;

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        userName = User.Identity.Name ?? "Vendég";
        initial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";

        var currentUser = await _CurrentUserService.GetCurrentUserAsync();
        profilePicUrl = currentUser?.ProfileImageUrl;
    }
}
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FodraszatIdopont</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=vegre-mukodj" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            #timeSlotsContainer {
                min-height: 220px;
            }
    </style>
</head>
<body>
    
    <header>
        <nav class="navbar navbar-expand-xl navbar-custom navbar-dark fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/fodraszikon.png" class="navbar-brand-img me-2" alt="Wild Cut logo" />
                    <span class="fs-4 fw-bold">Wild Cut</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" asp-controller="Home" asp-action="Index">Főoldal</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="szolgaltatasok">Szolgáltatások</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="galeria">Galéria</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="kapcsolat">Kapcsolat</a>
                        </li>

                        @if (_CurrentUserService.Roles.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Admin))
                        {
                            <li class="nav-item mx-2" data-bs-toggle="offcanvas" data-bs-target="#offcanvasScrolling" aria-controls="offcanvasScrolling">
                                <a class="nav-link" style="cursor: pointer;" @* hogy ne váltson át a kurzor szöveges módra*@>Menü megnyitása</a>
                            </li>
                        }

                        @if (_CurrentUserService.Roles.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Hairdresser))
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link" asp-controller="Hairdresser" asp-action="Appointments" asp-route-offset="0">Beosztás</a>
                            </li>
                        }

                        <li class="nav-item mx-2">
                            <a class="nav-link" asp-controller="User" asp-action="Index">Időpontjaim</a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link" asp-controller="Account" asp-action="MAAppointment">Időpontfoglalás</a>
                        </li>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown mx-2">
                                <a class="nav-link dropdown-toggle fw-bold d-flex align-items-center py-0"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false"
                                       style="height: 40px;">

                                    @if (!string.IsNullOrEmpty(profilePicUrl))
                                    {
                                        <img src="@profilePicUrl" alt="Profilkép" class="rounded-circle shadow-sm me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle shadow-sm me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; background-color: var(--accent-color); color: white; font-weight: bold; font-size: 1rem;">
                                            @initial
                                        </div>
                                    }
                                    @userName
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <a asp-controller="User" asp-action="EditProfile" class="dropdown-item">
                                            <i class="fas fa-user-cog me-2"></i>
                                            Profilom
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt me-2"></i>
                                                Kijelentkezés
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Bejelentkezés</a>
                            </li>
                            <li class="nav-item mx-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Registration">Regisztráció</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()

        <div class="offcanvas offcanvas-start shadow border-end-0" data-bs-scroll="true" data-bs-backdrop="false" tabindex="-1" id="offcanvasScrolling" style="border-right: 1px solid #eee;">
            <div class="offcanvas-header" style="background-color: var(--primary-color); color: var(--bg-light);">
                <h5 class="offcanvas-title fw-bold">Admin Menü</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body p-0" style="background-color: #fdfbf7;">
                <div class="list-group list-group-flush">
                    <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;"><i class="fas fa-users-cog me-2" style="color: #4b2c61;"></i>  Felhasználók kezelése</a>
                    <a asp-controller="Admin" asp-action="Services" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;"><i class="fas fa-cut me-2" style="color: #d182b5;"></i>  Szolgáltatások</a>
                    <a asp-controller="User" asp-action="Index" class="list-group-item list-group-item-action py-3 fw-bold" style="color: var(--primary-color); background-color: transparent;"><i class="fas fa-calendar-check me-2" style="color: #6c8dbf;"></i>  Saját Iőpontjaim</a>
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="list-group-item list-group-item-action py-3 fw-bold text-danger" style="color: var(--primary-color);">
                            <i class="fas fa-sign-out-alt me-2"></i>  Kijelentkezés
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="text-center" style="color: #d1c5b4; font-size: 0.85rem;">
                &copy; 2026 - Wild Cut Fodrászat. Minden jog fenntartva. <br />
                <span style="opacity: 0.7;">Készítette: Nagy Gábor és Belák Marcell</span>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.google.com/recaptcha/api.js?render=6LcZrYUsAAAAAACP_E34b7Jk6tQ998dO0969edqR"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const offcanvasToggleButtons = document.querySelectorAll('[data-bs-toggle="offcanvas"]');
        
            const navbarCollapse = document.querySelector('.navbar-collapse');

            if (offcanvasToggleButtons.length > 0 && navbarCollapse) {
                offcanvasToggleButtons.forEach(function (btn) {
                    btn.addEventListener('click', function () {

                        if (navbarCollapse.classList.contains('show')) {

                            const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                            if (bsCollapse) {
                                bsCollapse.hide();
                            }
                        }}
                    );
                });
            }
        });
    </script>
</body>
</html>