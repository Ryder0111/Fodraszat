@model List<FodraszatIdopont.Models.Entities.Appointment>

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="appointments-container">
    <h2>Saját Időpontjaim</h2>
    <p class="intro-text">Itt láthatod a közelgő foglalásaidat. Egy fiókhoz maximum 3 aktív időpont tartozhat.</p>

    <div class="appointments-grid">

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                // Státusz logika: itt döntjük el, milyen színe legyen a jelvénynek.
                // Ezt a saját modelledhez kell igazítani (lehet, hogy neked enumod van, pl. item.Status == AppointmentStatus.Approved)
                var badgeClass = "bg-danger-custom";
                var statuszSzoveg = "Lemondva";

                // Írd át a "Jóváhagyva" feltételt arra, ahogy te tárolod a jóváhagyott státuszt!
                if (item.AppointmentStatus == FodraszatIdopont.Models.Enums.AppointmentStatus.Booked)
                {
                    badgeClass = "bg-warning-custom";
                    statuszSzoveg = "Jóváhagyva";
                }

                if (item.AppointmentStatus == FodraszatIdopont.Models.Enums.AppointmentStatus.Completed)
                {
                    badgeClass = "bg-success-custom";
                    statuszSzoveg = "Befejezve";
                }

                <div class="appointment-card">
                    <div class="appointment-header">
                        @* C#-os dátumformázás magyarosan *@
                        <span class="appointment-date">@item.StartTime.ToString("yyyy. MMMM dd.")</span>
                        <span class="appointment-time">@item.StartTime.ToString("HH:mm")</span>
                    </div>
                    <div class="appointment-details">
                        @* A ? (null-conditional) operátor megvéd a hibáktól, ha véletlen nincs betöltve a kapcsolat *@
                        <p><strong>Szolgáltatás:</strong> @item.Service!.Name</p>
                        <p><strong>Fodrász:</strong> @item.Hairdresser?.Name</p>
                        <p><strong>Státusz:</strong> <span class="badge-custom @badgeClass">@statuszSzoveg</span></p>
                    </div>
                    <div class="appointment-footer">
                        @if (item.AppointmentStatus == FodraszatIdopont.Models.Enums.AppointmentStatus.Booked)
                        {
                            <form asp-action="CancelAppointment" asp-route-id="@item.AppointmentId" method="post" onsubmit="return confirm('Biztosan le szeretnéd mondani ezt az időpontot?');">
                                <button type="submit" class="btn-cancel">Időpont lemondása</button>
                            </form>
                        }
                        else if (item.AppointmentStatus == FodraszatIdopont.Models.Enums.AppointmentStatus.Completed)
                        {
                            <button class="btn-cancel btn-cancel-success" disabled>Időpont befejezve</button>
                        }
                        else
                        {
                            <button class="btn-cancel" disabled>Időpont lemondva</button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info" style="width: 100%; text-align: center; max-width: 600px; margin: 0 auto;" role="alert">
                Jelenleg nincs aktív foglalásod.
            </div>
        }

    </div>
</div>