@using FodraszatIdopont.Services.Interface;
@inject ICurrentUserService _CurrentUserService;
@model FodraszatIdopont.Models.ViewModels.EditProfileViewModel;

@{
    ViewData["Title"] = "Profil szerkesztése";
    // Kiszámoljuk a kezdőbetűt (Ha van név, vesszük az első betűt, különben egy '?' jelet)
    var firstLetter = !string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "?";

    var isAdmin = _CurrentUserService.Roles.HasFlag(FodraszatIdopont.Models.Enums.UserRole.Admin);
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #28a745;">
        <strong>Sikeres!</strong> @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

@if (TempData["error_msg"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show floating-alert shadow-lg" role="alert" style="border-left: 5px solid #dc3545;">
        <strong>Hiba történt!</strong> @TempData["error_msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="m-0 text-dark fw-bold">Adatok <span style="color: var(--accent-color);">módosítása</span></h2>
                    <p class="text-muted m-0">Frissítsd a személyes adataidat</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary shadow-sm" style="border-radius: 5px;">
                    <i class="fas fa-arrow-left me-1"></i> Vissza
                </a>
            </div>

            <form id="editProfileForm" asp-action="EditProfile" method="post" enctype="multipart/form-data" class="bg-white p-4 p-md-5 rounded shadow-sm" style="border-top: 5px solid var(--primary-color);">
                @Html.AntiForgeryToken()

                <!-- REJTETT MEZŐK -->
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CurrentProfileImageUrl" />

                <!-- PROFILKÉP / KEZDŐBETŰ SZEKCIÓ -->
                <div class="text-center mb-5">
                    <!-- EZT A SORT VÁLTOZTATTUK MEG: d-inline-flex flex-column align-items-center -->
                    <div class="position-relative d-inline-flex flex-column align-items-center">

                        @if (!string.IsNullOrEmpty(Model.CurrentProfileImageUrl))
                        {
                            <img src="@Model.CurrentProfileImageUrl" alt="Profilkép" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;" />
                        }
                        else
                        {
                            <div class="rounded-circle shadow-sm d-flex justify-content-center align-items-center" style="width: 120px; height: 120px; background-color: var(--primary-color); color: white; font-size: 3rem; font-weight: bold; border: 4px solid #fff;">
                                @firstLetter
                            </div>
                        }

                        <div class="mt-3">
                            <label for="ProfileImage" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" style="cursor: pointer;" id="uploadLabel">
                                <i class="fas fa-camera me-1"></i> Kép módosítása
                            </label>
                            <input type="file" asp-for="ProfileImage" class="d-none" id="ProfileImage" accept="image/jpeg, image/png, image/webp">
                        </div>

                    </div>
                </div>

                <!-- SZÖVEGES ADATOK SZEKCIÓ -->
                <div class="mb-4">
                    <label class="form-label fw-bold" style="color: var(--primary-color);">Teljes Név</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: #eee;">
                            <i class="fas fa-user"></i>
                        </span>
                        <input type="text" asp-for="Name" class="form-control form-control-lg @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="Kovács János" style="border-color: #eee;">
                    </div>
                    <span asp-validation-for="Name" class="text-danger small fw-bold d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold" style="color: var(--primary-color);">Email cím</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: #eee;">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="email" asp-for="Email" class="form-control form-control-lg @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="email@pelda.com" style="border-color: #eee;">
                    </div>
                    <span asp-validation-for="Email" class="text-danger small fw-bold d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold" style="color: var(--primary-color);">Telefon szám</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: #eee;">
                            <i class="fas fa-phone"></i>
                        </span>
                        <input type="tel" asp-for="Phone" id="phoneInput" class="form-control form-control-lg @(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "is-invalid" : "")" placeholder="+36 (20) 000-0000" style="border-color: #eee;">
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small fw-bold d-block mt-1"></span>
                </div>

                <div class="mb-5">
                    <label class="form-label fw-bold" style="color: var(--primary-color);">Nem</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: #eee;">
                            <i class="fas fa-venus-mars"></i>
                        </span>
                        <select asp-for="Sex" class="form-select form-select-lg @(ViewData.ModelState["Sex"]?.Errors.Count > 0 ? "is-invalid" : "")" style="border-color: #eee;">
                            <option value="None" disabled>Válassz...</option>
                            <option value="Male">Férfi</option>
                            <option value="Female">Nő</option>
                        </select>
                    </div>
                    <span asp-validation-for="Sex" class="text-danger small fw-bold d-block mt-1"></span>
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm" style="background-color: var(--primary-color); color: white; transition: all 0.3s ease;">
                    <i class="fas fa-save me-2"></i> Módosítások mentése
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    @if (!isAdmin) //Így az adminnak nem jelenek mg a modelsate hibák
    {
        <partial name="_ValidationScriptsPartial" />
    }
    <script>
        $(document).ready(function () {
            // Megnézzük Razor-rel, hogy Admin-e

            // HA ADMIN: Kikapcsoljuk a validációt JS-ből (így nem kell a form tag-be írni semmit!)
            if (@isAdmin) {
                $('#editProfileForm').attr('novalidate', 'novalidate');
            }

            $('#editProfileForm').on('submit', function (e) {
                var form = $(this);

                if (!isAdmin && !form.valid()) {
                    return; 
                }

                e.preventDefault(); 

                Swal.fire({
                    title: 'Mented a módosításokat?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Igen, mentés!',
                    cancelButtonText: 'Mégse'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form[0].submit(); 
                    }
                });
            });
        });
    </script>
}